CREATE TABLE CUSTOMER (
    CUST_ID INT IDENTITY(1,1) PRIMARY KEY,
    FIRST_NAME VARCHAR(50) NOT NULL,
    LAST_NAME VARCHAR(50) NOT NULL,
    EMAIL VARCHAR(100) NOT NULL,
    PHONE VARCHAR(20)
);

CREATE TABLE ORDER# (
    ORDER_ID INT IDENTITY(1,1) PRIMARY KEY,
    DATE_TIME DATETIME NOT NULL,
    ORDER_TOTAL DECIMAL(8,2) NOT NULL,
    PAYMENT_TYPE VARCHAR(30) NOT NULL
);

CREATE TABLE ORDER_ITEM (
    ORDER_ITEM_ID INT IDENTITY(1,1) PRIMARY KEY,
    ITEMS VARCHAR(100) NOT NULL,
    QTY INT NOT NULL,
    SELLING_PRICE DECIMAL(8,2) NOT NULL
);

CREATE TABLE PICKUP_OPTION (
    OPTION_ID INT IDENTITY(1,1) PRIMARY KEY,
    DESCRIPTION_PICKUP VARCHAR(100) NOT NULL
);

CREATE TABLE PRODUCT (
    PRODUCT_ID INT IDENTITY(1,1) PRIMARY KEY,
    PRODUCT_NAME VARCHAR(100) NOT NULL,
    SIZE_PRODUCT VARCHAR(20) NOT NULL,
    PRICE DECIMAL(8,2) NOT NULL,
    COLOR VARCHAR(30) NOT NULL,
    CATEGORY VARCHAR(50) NOT NULL
);

CREATE TABLE EMPLOYEE (
    EMPLOYEE_ID INT IDENTITY(1,1) PRIMARY KEY,
    FIRST_NAME VARCHAR(50) NOT NULL,
    LAST_NAME VARCHAR(50) NOT NULL
);

CREATE TABLE INVENTORY (
    INVENTORY_ID INT IDENTITY(1,1) PRIMARY KEY,
    PRODUCT_ID INT NOT NULL,
    QUANTITY INT NOT NULL,
    FOREIGN KEY (PRODUCT_ID) REFERENCES PRODUCT(PRODUCT_ID)
);

CREATE TABLE SUBSTITUTE_SUGGESTION (
    SUGGESTION_ID INT IDENTITY(1,1) PRIMARY KEY,
    ORDER_ITEM_ID INT NOT NULL,
    SUBSTITUTION_ID INT NOT NULL,
    ACCEPTED VARCHAR(3),
    FOREIGN KEY (ORDER_ITEM_ID) REFERENCES ORDER_ITEM(ORDER_ITEM_ID)
);

CREATE TABLE PAYMENT_METHOD (
    PAYMENT_METHOD_ID INT IDENTITY(1,1) PRIMARY KEY,
    CARD_METHOS VARCHAR(10),
    CASH VARCHAR(10),
    CHECK_METHOD VARCHAR(10)
);

CREATE TABLE PAYMENTS (
    PAYMENT_ID INT IDENTITY(1,1) PRIMARY KEY,
    AMOUNT_AUTHORIZED DECIMAL(8,2) NOT NULL,
    FINAL_AMOUNT DECIMAL(8,2) NOT NULL,
    PAYMENT_METHOD VARCHAR(30) NOT NULL,
    STATUS_PAYMENTS VARCHAR(30) NOT NULL
);

CREATE TABLE READY_NOTIFICATION (
    NOTIFICATION_ID INT IDENTITY(1,1) PRIMARY KEY,
    SENT_AT DATETIME NOT NULL,
    DESCRIPTION_NOTIFICATION VARCHAR(100)
);

CREATE TABLE PARKING_SPOT (
    PARKING_SPOT_ID INT IDENTITY(1,1) PRIMARY KEY,
    SPOT_NUMBER INT NOT NULL
);

CREATE TABLE CHECK_IN (
    CHECK_IN_ID INT IDENTITY(1,1) PRIMARY KEY,
    ORDER_ID INT NOT NULL,
    SPOT_ID INT NOT NULL,
    CHECK_IN_TIME_ID DATETIME,
    FOREIGN KEY (ORDER_ID) REFERENCES ORDER#(ORDER_ID),
    FOREIGN KEY (SPOT_ID) REFERENCES PARKING_SPOT(PARKING_SPOT_ID)
);

CREATE TABLE DELIVERY_CONFIRMATION (
    DELIVERY_ID INT IDENTITY(1,1) PRIMARY KEY,
    DELIVERY_DRIVER VARCHAR(100) NOT NULL,
    COMFIRMATION_TIME DATETIME NOT NULL
);

