USE Campus_Event;
GO

CREATE TABLE USER_NAME (
    USER_ID INT IDENTITY(1,1) PRIMARY KEY,
    FIRST_NAME VARCHAR(50) NOT NULL,
    LAST_NAME VARCHAR(50) NOT NULL,
    EMAIL VARCHAR(100) UNIQUE NOT NULL,
    PHONE VARCHAR(20),
    PASSWORD_HASH VARCHAR(255) NOT NULL,
    CREATED_AT DATETIME NOT NULL,
    STATUS_USER VARCHAR(20) NOT NULL
);


CREATE TABLE TICKETS (
    TICKET_ID INT IDENTITY(1,1) PRIMARY KEY,
    SEAT_ID INT NULL,
    TICKET_TYPE VARCHAR(30) NOT NULL,
    PRICE DECIMAL(6,2) NOT NULL,
    QR_CODE_VALUE VARCHAR(100),
    TICKET_STATUS VARCHAR(30) NOT NULL,
    CREATED_AT DATETIME NOT NULL
);

CREATE TABLE WAITING_LIST (
    WAITING_LIST_ID INT IDENTITY(1,1) PRIMARY KEY,
    USER_ID INT NOT NULL,
    REQUESTED_TICKET_TYPE VARCHAR(30) NOT NULL,
    FOREIGN KEY (USER_ID) REFERENCES USER_NAME(USER_ID)
);

CREATE TABLE TICKET_ASSIGNMENT (
    TICKET_ASSIGNMENT_ID INT IDENTITY(1,1) PRIMARY KEY,
    TICKET_ID INT NOT NULL,
    USER_ID INT NOT NULL,
    ASSIGNED_AT DATETIME NOT NULL,
    ASSIGNMENT_STATUS VARCHAR(30) NOT NULL,
    FOREIGN KEY (TICKET_ID) REFERENCES TICKETS(TICKET_ID),
    FOREIGN KEY (USER_ID) REFERENCES USER_NAME(USER_ID)
);

CREATE TABLE TRANSACTIONS (
    TRANSACTION_ID INT IDENTITY(1,1) PRIMARY KEY,
    USER_ID INT NOT NULL,
    EVENT_ID INT NOT NULL,
    TRANSACTION_DATETIME DATETIME NOT NULL,
    SUBTOTAL_AMOUNT DECIMAL(8,2) NOT NULL,
    TAX_AMOUNT DECIMAL(8,2),
    FEE_AMOUNT DECIMAL(8,2),
    TOTAL_AMOUNT DECIMAL(8,2) NOT NULL,
    TRANSACTION_STATUS VARCHAR(30) NOT NULL,
    FOREIGN KEY (USER_ID) REFERENCES USER_NAME(USER_ID)
);

CREATE TABLE PAYMENT (
    PAYMENT_ID INT IDENTITY(1,1) PRIMARY KEY,
    TRANSACTION_ID INT NOT NULL,
    PAYMENT_METHOD VARCHAR(30) NOT NULL,
    CARD_LAST4 CHAR(4),
    AUTHORIZATION_CODE VARCHAR(50),
    AMOUNT_PAID DECIMAL(8,2) NOT NULL,
    PAID_AT DATETIME,
    FOREIGN KEY (TRANSACTION_ID) REFERENCES TRANSACTIONS(TRANSACTION_ID)
);

CREATE TABLE ATTENDANCE (
    ATTENDANCE_ID INT IDENTITY(1,1) PRIMARY KEY,
    EVENT_ID INT NOT NULL,
    TICKET_ASSIGNMENT_ID INT NOT NULL,
    SCANNED_BY_EMPLOYEE_ID INT NOT NULL,
    SCAN_TIME DATETIME NOT NULL,
    FOREIGN KEY (TICKET_ASSIGNMENT_ID) REFERENCES TICKET_ASSIGNMENT(TICKET_ASSIGNMENT_ID)
);

CREATE TABLE NO_SHOWS (
    NO_SHOW_ID INT IDENTITY(1,1) PRIMARY KEY,
    EVENT_ID INT NOT NULL,
    TICKET_ASSIGNMENT_ID INT NOT NULL,
    ACTION_TAKEN VARCHAR(30) NOT NULL,
    NOTES VARCHAR(200),
    FOREIGN KEY (TICKET_ASSIGNMENT_ID) REFERENCES TICKET_ASSIGNMENT(TICKET_ASSIGNMENT_ID)
);

CREATE TABLE REFUND (
    REFUND_ID INT IDENTITY(1,1) PRIMARY KEY,
    PAYMENT_ID INT NOT NULL,
    TRANSACTION_ID INT NOT NULL,
    TICKET_ID INT NOT NULL,
    REQUESTED_BY_USER_ID INT NOT NULL,
    PROCESSED_BY_EMPLOYEE_ID INT,
    REFUND_AMOUNT DECIMAL(8,2) NOT NULL,
    REFUND_REASON VARCHAR(200),
    REFUND_STATUS VARCHAR(30) NOT NULL,
    FOREIGN KEY (PAYMENT_ID) REFERENCES PAYMENT(PAYMENT_ID),
    FOREIGN KEY (TRANSACTION_ID) REFERENCES TRANSACTIONS(TRANSACTION_ID),
    FOREIGN KEY (TICKET_ID) REFERENCES TICKETS(TICKET_ID),
    FOREIGN KEY (REQUESTED_BY_USER_ID) REFERENCES USER_NAME(USER_ID)
);

